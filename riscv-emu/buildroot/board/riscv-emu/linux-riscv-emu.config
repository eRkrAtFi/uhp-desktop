# Kernel config fragment, merged onto the riscv arch's own default
# config (BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG) by Buildroot's
# merge_config. Verified post-build by scripts/verify-config-fragment.sh
# (see guest-images.yml) - every line below must survive into the
# built kernel's own .config unchanged, or the build fails. That check
# exists specifically because a Kconfig dependency silently unmet (not a
# typo, a real "this needs X which isn't set" case) drops an option
# without any other warning - exactly the class of bug a "boots, but
# missing virtio-net" failure three steps later would otherwise hide.
#
# This targets exactly the device set riscv-emu/src/emu.h and dtb.c
# implement today - nothing guessed, nothing aspirational.

# Console: riscv-emu's UART is a 16550-compatible device on ttyS0.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# PLIC: riscv-emu's external-interrupt controller (UART IRQ routing).
CONFIG_SIFIVE_PLIC=y

# virtio-mmio: both device slots riscv-emu implements.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# Goldfish RTC - riscv-emu's own RTC device model.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y

# Filesystems fs-compare and general guest use need.
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y

# Networking core - without these, virtio-net exists but nothing above
# it (udhcpc/ping/wget's own AF_INET/AF_PACKET sockets) works.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y

# Poweroff: riscv-emu's TESTDEV (SiFive-test-finisher-style MMIO) has a
# syscon-poweroff DT node (dtb.c, Phase 10) - bind the real driver to it
# instead of relying only on the SBI shutdown path firmware.S already
# handles today. Verify at build/boot time which path Linux actually
# takes (syscon-poweroff probing first, or falling through to SBI) and
# confirm plain `poweroff` (no -f) works either way - see the plan's own
# verification section.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# Optional RISC-V ISA extensions riscv-emu does not implement - its own
# cpu.c decodes exactly I/M/A/F/D/C (Zicsr+Zifencei implied) and nothing
# past that. Every one of these defaults to y in the kernel's own
# arch/riscv/Kconfig (verified directly against the v6.18 tag's actual
# Kconfig text, not guessed/remembered) and would otherwise make the
# running kernel probe for and silently use an extension that does not
# exist in this emulator - the exact class of mismatch "stop and report
# the instruction" (see this project's own verification policy) exists
# to catch, just one layer further down, as a kernel-side probe rather
# than a guest program actually executing the missing opcode.
# CONFIG_RISCV_ISA_SUPM is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZABHA has no line here (confirmed against a real CI
# build of this exact fragment+toolchain): it `depends on
# TOOLCHAIN_HAS_ZABHA`, a cc-option probe for `-march=..._zabha` that the
# pinned Bootlin toolchain's GCC does not support - the symbol does not
# materialize in the built .config AT ALL (not even as "is not set"),
# which verify-config-fragment.sh correctly reports as a mismatch against
# a literal "# ... is not set" line. Already off either way; a fragment
# line here would just be a check against a line that can never exist.
#
# CONFIG_RISCV_ISA_C and CONFIG_FPU are left at their y default - riscv-emu
# does implement compressed instructions and F/D (see the defconfig's own
# remarks on BR2_RISCV_ISA_RVC). RISCV_ISA_V_DEFAULT_ENABLE/
# RISCV_ISA_V_PREEMPTIVE have no fragment line of their own: both
# `depends on RISCV_ISA_V`, so turning V off above already makes Kconfig
# force them off too - a redundant line here would just be noise
# verify-config-fragment.sh has to keep correct for no reason.

# Single hart - riscv-emu has no SMP. NR_CPUS has no line here (confirmed
# against a real CI build): it only becomes a visible, settable symbol
# `depends on SMP` - with SMP off, there is nothing for a fragment line
# to set, and merge_config correctly leaves it absent rather than "=1".
# CONFIG_SMP is not set

# riscv-emu implements no PCI/PCIe controller - virtio is MMIO-only here.
# CONFIG_PCI is not set

# Appliance kernel: everything above is built in (BR2_PACKAGE_HOST_* /
# CONFIG_MODULES off keeps the initramfs from needing a modules.dep step
# or any module-loading machinery at all), and none of the following is
# reachable from riscv-emu's own device set, so trimming them keeps the
# Image small and boot fast rather than aspirational hardening. LOCKDEP
# and DEBUG_INFO have no line here (confirmed against a real CI build):
# both only become visible `depends on DEBUG_KERNEL`, which the arch
# default config this fragment merges onto already leaves off - nothing
# for a fragment line to disable, same reasoning as NR_CPUS above.
# CONFIG_MODULES is not set
# CONFIG_KASAN is not set
# CONFIG_FTRACE is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_INPUT: a real CI build showed this fragment's own
# "# CONFIG_INPUT is not set" line does NOT survive - something reachable
# from the riscv arch default config this fragment merges onto selects it
# back on (not yet identified exactly which driver; USB_SUPPORT and DRM
# are already off above, so it is most likely a PS/2-class (SERIO/i8042)
# or similar onboard-keyboard/mouse path the arch default enables for
# real hardware). Left on deliberately rather than chased further: it
# costs code size, not correctness - riscv-emu models no input device at
# all, so nothing in this image ever calls into it.
