# busybox config fragment, merged onto Buildroot's own default busybox
# config. Explicit rather than relying on "the default already has
# these" (which is true today, confirmed against Buildroot's own
# package/busybox/busybox.config, but is Buildroot's own choice to
# change, not a guarantee this project controls) - every applet
# boot-test/interactive-test/fs-compare/SelfTest or a real guest session
# actually exercises today is named here explicitly (TAR below is the
# one deliberate exception - a forward-looking placeholder for a feature
# that does not exist yet, see its own comment), so a future Buildroot
# default that drops one fails loudly (verify-config-fragment.sh, the
# same fragment-survives check used for the kernel config, applied to
# busybox's own .config in CI too) instead of silently breaking a test
# with no obvious cause.
CONFIG_ASH=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_JOB_CONTROL=y
# SH_IS_ASH, not FEATURE_SH_IS_ASH - the latter does not exist as a
# symbol in Buildroot 2026.08.2's pinned busybox (1.38.0); a real CI
# build showed it silently dropped (unrecognized symbols are not an
# error to kconfig's own olddefconfig, just ignored - the exact kind of
# silent loss this whole fragment-verify mechanism exists to catch, one
# level up from a single wrong symbol name). This is what actually
# selects ash for the "sh" applet name/the /bin/sh symlink.
CONFIG_SH_IS_ASH=y

# Serial console login (inittab's own riscv-emu-shell wrapper calls this).
CONFIG_GETTY=y

# fs-compare: mkfs.ext2 + mount + write + md5sum + umount.
CONFIG_MKFS_EXT2=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_MD5SUM=y

# Networking: DHCP (BR2_SYSTEM_DHCP="eth0" in the top-level defconfig
# calls udhcpc), ip for interface/route inspection, ping/wget for the
# same guest-network scenarios this project's own README documents
# (SelfTest's Scenario 3, the Ctrl+C/ping latency work).
CONFIG_UDHCPC=y
CONFIG_IP=y
CONFIG_PING=y
CONFIG_WGET=y

# tar: for the planned Alpine-minirootfs-onto-a-disk feature (README's
# "Phase 10") - NOT yet implemented by any script today (double-checked:
# fs_compare.sh does not call tar or reference Alpine at all despite this
# comment's own earlier claim that it does - corrected here). Kept as a
# forward-looking placeholder, not a current dependency of any test.
# No FEATURE_TAR_GZIP line: that symbol was not found anywhere in
# Buildroot 2026.08.2's pinned busybox (1.38.0) Kconfig sources either
# (same silent-drop as FEATURE_SH_IS_ASH above) - CONFIG_GUNZIP=y is
# already Buildroot's own busybox.config default, so gzip support exists
# regardless; CONFIG_FEATURE_SEAMLESS_GZ (off by default) is the real
# "tar auto-handles a .gz archive" integration symbol, if a plain
# tar/gunzip pipeline (used explicitly, not tar's own -z) turns out not
# to be enough once Phase 10 actually gets built - verify against a real
# build then, not guessed now for a feature nothing yet exercises.
CONFIG_TAR=y

# Poweroff/reboot - see linux-riscv-emu.config's own remarks on
# CONFIG_POWER_RESET_SYSCON_POWEROFF for the kernel side of this.
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
