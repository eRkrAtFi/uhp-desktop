<Window x:Class="QemuManager.CreateDiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Disk Image" Height="220" Width="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="File"/>
        <TextBox x:Name="PathBox" Grid.Row="0" Grid.Column="1"/>
        <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size (GB)"/>
        <TextBox x:Name="SizeBox" Grid.Row="1" Grid.Column="1" Text="20"/>

        <TextBlock x:Name="ValidationText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Foreground="{StaticResource ErrorText}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CreateButton" Content="Create" Click="CreateButton_Click" Background="{StaticResource SuccessBg}"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
