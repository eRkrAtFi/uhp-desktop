<Window x:Class="QemuManager.VmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Configuration" Height="680" Width="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" ResizeMode="NoResize">
    <Window.Resources>
        <!-- This window's fields are laid out label/value in a Grid rather
             than App.xaml's default stacked-field Margin, so its TextBlock/
             TextBox/Button get their own small overrides, based on the
             shared style rather than redefining it. -->
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-6,0,10"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Save" Click="OkButton_Click" Background="{StaticResource SuccessBg}"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/> <RowDefinition/> <RowDefinition Height="Auto"/> <RowDefinition/>
                    <RowDefinition/> <RowDefinition/> <RowDefinition/> <RowDefinition/>
                    <RowDefinition/> <RowDefinition/> <RowDefinition/> <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"/>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="VM name"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture"/>
                <ComboBox x:Name="ArchitectureBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Architecture selection"/>

                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ArchHintText" Style="{StaticResource HintText}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory (MB)"/>
                <TextBox x:Name="MemoryBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Memory MB"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="CPU cores"/>
                <TextBox x:Name="CpuBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="CPU cores field"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Accelerator"/>
                <ComboBox x:Name="AccelBox" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Accelerator selection">
                    <ComboBoxItem Content="tcg (software, always works)"/>
                    <ComboBoxItem Content="whpx (hardware, needs Hyper-V Platform)"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Machine type"/>
                <TextBox x:Name="MachineTypeBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Machine type field"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Firmware / BIOS"/>
                <Grid Grid.Row="7" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FirmwareBox" Grid.Column="0" AutomationProperties.Name="Firmware path"/>
                    <Button x:Name="FirmwareBrowseButton" Grid.Column="1" Content="Browse..." Click="FirmwareBrowseButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Disk image"/>
                <Grid Grid.Row="8" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DiskBox" Grid.Column="0" AutomationProperties.Name="Disk path"/>
                    <Button x:Name="DiskBrowseButton" Grid.Column="1" Content="Browse..." Click="DiskBrowseButton_Click"/>
                    <Button x:Name="DiskCreateButton" Grid.Column="2" Content="New..." Click="DiskCreateButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="CD-ROM / ISO"/>
                <Grid Grid.Row="9" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CdromBox" Grid.Column="0" AutomationProperties.Name="CD-ROM path"/>
                    <Button x:Name="CdromBrowseButton" Grid.Column="1" Content="Browse..." Click="CdromBrowseButton_Click"/>
                    <Button x:Name="CdromClearButton" Grid.Column="2" Content="Clear" Click="CdromClearButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Network"/>
                <ComboBox x:Name="NetworkBox" Grid.Row="10" Grid.Column="1" AutomationProperties.Name="Network mode">
                    <ComboBoxItem Content="User-mode NAT (default, no setup needed)"/>
                    <ComboBoxItem Content="None"/>
                </ComboBox>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Display backend"/>
                <ComboBox x:Name="DisplayBox" Grid.Row="11" Grid.Column="1" AutomationProperties.Name="Display backend selection">
                    <ComboBoxItem Content="gtk (QEMU opens its own window)"/>
                    <ComboBoxItem Content="sdl (QEMU opens its own window)"/>
                    <ComboBoxItem Content="console (text console in this app's own window)"/>
                    <ComboBoxItem Content="vnc (headless - closing a VNC client never stops the VM)"/>
                </ComboBox>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Boot order"/>
                <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Vertical">
                    <TextBox x:Name="BootOrderBox" AutomationProperties.Name="Boot order field"/>
                    <TextBlock Text="c = disk first, d = CD-ROM first, n = network" FontSize="11" Opacity="0.7" Margin="0,-6,0,10"/>
                    <TextBlock Text="Extra arguments" Margin="0,0,0,4"/>
                    <TextBox x:Name="ExtraArgsBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
