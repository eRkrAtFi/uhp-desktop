<Window x:Class="QemuManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="Height" Width="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" ResizeMode="NoResize">
    <!-- QEMU/riscv-emu install paths moved to the Engines page (Phase 6) -
         they are each one engine's own install location, not a general
         app setting, and that page already shows path/version/status
         together, with Browse right next to the same validation this
         window used to show only after OK. Only genuinely general
         things (nothing tied to one specific engine) stay here. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="riscv-emu Shut Down timeout" Margin="0,0,0,6"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Text="(how long Shut Down waits for the guest to power itself off before offering Force Stop)"
                   Opacity="0.7" HorizontalAlignment="Right" FontSize="11" TextWrapping="Wrap" MaxWidth="320"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="RiscvShutdownTimeoutBox" Width="60" AutomationProperties.Name="riscv-emu Shut Down timeout in seconds"/>
            <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- AssemblyInformationalVersionAttribute, the same string a
             published .exe's own "Product Version" file property shows
             (see QemuManager.csproj's SetSourceRevisionId target) - so
             "which build is this" stops depending on remembering a
             publish timestamp. -->
        <TextBlock x:Name="VersionText" Grid.Row="4" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
    </Grid>
</Window>
