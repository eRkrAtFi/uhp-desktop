<Window x:Class="QemuManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="Height" Width="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QEMU installation directory" Margin="0,0,0,6"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Text="(contains qemu-system-*.exe and qemu-img.exe)"
                   Opacity="0.7" HorizontalAlignment="Right" FontSize="11"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QemuDirBox" Grid.Column="0" AutomationProperties.Name="QEMU directory"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="BrowseButton_Click" AutomationProperties.Name="Browse QEMU directory"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="riscv-emu directory" Margin="0,0,0,6"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="3" Text="(contains riscv-emu.exe and boot\firmware.bin)"
                   Opacity="0.7" HorizontalAlignment="Right" FontSize="11"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RiscvEmuDirBox" Grid.Column="0" AutomationProperties.Name="riscv-emu directory"/>
            <Button x:Name="RiscvEmuBrowseButton" Grid.Column="1" Content="Browse..." Click="RiscvEmuBrowseButton_Click" AutomationProperties.Name="Browse riscv-emu directory"/>
        </Grid>

        <TextBlock Grid.Row="6" Text="riscv-emu Shut Down timeout" Margin="0,0,0,6"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="6" Text="(how long Shut Down waits for the guest to power itself off before offering Force Stop)"
                   Opacity="0.7" HorizontalAlignment="Right" FontSize="11" TextWrapping="Wrap" MaxWidth="380"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal">
            <TextBox x:Name="RiscvShutdownTimeoutBox" Width="60" AutomationProperties.Name="riscv-emu Shut Down timeout in seconds"/>
            <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="8" Margin="0,8,0,0" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- AssemblyInformationalVersionAttribute, the same string a
             published .exe's own "Product Version" file property shows
             (see QemuManager.csproj's SetSourceRevisionId target) - so
             "which build is this" stops depending on remembering a
             publish timestamp. -->
        <TextBlock x:Name="VersionText" Grid.Row="10" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
    </Grid>
</Window>
