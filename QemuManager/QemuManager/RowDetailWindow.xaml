<Window x:Class="QemuManager.RowDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details" Width="560" Height="420" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}">
    <!-- Generic "full text + copy" detail view for one row of any grid
         (Recent Tasks, Storage, Networking - PR #7 feedback: long
         Target/Result values truncated in the grid itself had no way to
         be read in full before this). Each field is a read-only,
         selectable TextBox (not a TextBlock) specifically so its text
         can be selected and copied the normal Windows way, on top of
         (not instead of) the "Copy all" button below. -->
    <DockPanel Margin="16">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyAllButton" Content="Copy all" Click="CopyAllButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
