<Application x:Class="QemuManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QemuManager"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- One dark palette for every window and dialog (Phase 1 of the UI
             overhaul) - previously MainWindow had its own, richer palette
             while every dialog (SettingsWindow, VmEditWindow, ...) carried
             an almost-but-not-quite-matching set of hardcoded hex colors
             repeated in each file's own Window.Resources. Both the values
             and the styles live here now, once. -->
        <SolidColorBrush x:Key="Accent" Color="#3DA5F4"/>
        <SolidColorBrush x:Key="WindowBg" Color="#181A1F"/>
        <SolidColorBrush x:Key="PanelBg" Color="#20232B"/>
        <SolidColorBrush x:Key="CardBg" Color="#252932"/>
        <SolidColorBrush x:Key="CardBorder" Color="#343a46"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#14161B"/>
        <SolidColorBrush x:Key="TextDim" Color="#8C93A3"/>
        <SolidColorBrush x:Key="ErrorText" Color="#E07070"/>
        <SolidColorBrush x:Key="SuccessBg" Color="#2E6B3E"/>
        <SolidColorBrush x:Key="DangerBg" Color="#7A2E2E"/>
        <SolidColorBrush x:Key="StatusRunning" Color="#3FB950"/>
        <SolidColorBrush x:Key="StatusTransition" Color="#E0A530"/>
        <SolidColorBrush x:Key="StatusStopped" Color="#9A9A9A"/>

        <!-- VM detail page (Phase 3): switches between the live stats
             view and the stopped-VM config summary (BoolToVis/
             InverseBoolToVis on IsRunning), and hides the Guest Detail
             (QMP) tile for an engine that cannot report one
             (BoolToVis on Hardware.SupportsGuestDetail) - see
             VmHardwareDescription's own remarks on why that capability
             lives in Core, not as a Kind check in this XAML. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- WPF's default ComboBoxItem/Popup chrome, and several other
             built-in controls, pull some of their own brushes from these
             SystemColors keys instead of from an explicit style - overriding
             them here (once, for every window) makes every built-in control
             that falls back to them follow this app's dark palette too,
             regardless of the OS theme. Previously only VmEditWindow did
             this, so a ComboBox anywhere else still rendered with a white
             system popup. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252932"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252932"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#252932"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3DA5F4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8C93A3"/>

        <!-- Every window in the app (MainWindow, ConsoleWindow, every
             dialog) gets the app icon once, here, rather than each one's
             own XAML repeating "Icon=...". Keyless/TargetType-matched, the
             same pattern as the Button/TextBlock/etc. styles above -
             implicit style lookup for a Control walks up from the
             instance's own type to find a match, so this reaches every
             Window subclass in the app automatically, present or future. -->
        <Style TargetType="Window">
            <Setter Property="Icon" Value="pack://application:,,,/Assets/uhp.ico"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-6,0,10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default ComboBox ControlTemplate bakes its closed-box
             background into its own chrome instead of using
             {TemplateBinding Background}, so a plain Background setter is
             silently ignored there - only the dropdown popup's ComboBoxItem
             template honors simple setters. Replacing the whole template is
             the only reliable fix for the closed box. Previously this lived
             only in VmEditWindow.xaml; every other ComboBox in the app (none
             yet, but Phase 2+ will add more) gets it for free now.

             ContentSite's own TextElement.Foreground binding below was
             missing until found via docs/screenshot.png: the closed box's
             selected-value text (Architecture/Accelerator/Network/Display
             backend in the VM Configuration dialog) rendered dim/gray
             instead of this style's own Foreground=#F1F1F1, since a bare
             ContentPresenter does not inherit Foreground from its
             TemplatedParent automatically - it needs the explicit
             TextElement.Foreground attached-property binding WPF uses for
             exactly this. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#F1F1F1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="6,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Every popup-style surface (right-click menus, tooltips) gets
             the same dark palette as everything else - previously
             unstyled, so ContextMenu/MenuItem fell back to the OS theme's
             own near-white popup chrome and near-white-on-white text,
             unreadable against this app's own dark windows. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource CardBorder}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyless/TargetType-matched (unlike VmListBoxItem just below,
             a leftover from the pre-DataGrid card-style VM list, not
             referenced anywhere any more) - applies to any plain ListBox
             in the app that does not opt into its own ItemContainerStyle,
             which today means RecentTasksList. Same IsSelected-only (not
             IsSelectionActive) pattern as TreeViewItem/DataGridRow/
             ComboBoxItem above, for the same reason: WPF's own default
             ListBoxItem template falls back to
             SystemColors.InactiveSelectionHighlightBrush once the window
             loses focus, which at this app's own dark palette renders as
             unreadable near-white-on-near-white. RecentTasksList's own
             rows are not really meant to be a selectable list (it is a
             passive log), but ListBox still lets a row be clicked into
             a selected state by default, and this is what that then
             looks like without an explicit style of its own. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1B2A3D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1C1F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VmListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorderEl" Background="{StaticResource CardBg}" CornerRadius="7"
                                BorderThickness="1.5" BorderBrush="{StaticResource CardBorder}" Padding="16,13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorderEl" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorderEl" Property="Background" Value="#2B303B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain WPF ProgressBar already renders its fill proportional to
             Value/Maximum on its own - no converter needed, just restyle
             colors/height to look like a slim modern meter instead of the
             default chunky Windows-theme bar. -->
        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#3A3F4B"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="10,10,10,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#C7CBD4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#20242E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Virtual Machines grid (Phase 2) - WPF's default DataGrid chrome
             is plain system light-gray; restyled to the same dark palette
             as everything else rather than letting it stand out as the one
             unthemed control in the app. -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <!-- Confirmed real bug, not theoretical: double-clicking a row
                 (or landing on a cell any other way a double-click can)
                 entered WPF's own default cell-edit mode, and committing
                 that edit tried a TwoWay write-back to a bound property
                 with no setter (Name/Status/Engine/... on VmListItem are
                 all get-only) - "A TwoWay or OneWayToSource binding cannot
                 work on the read-only property 'Name'", an unhandled
                 exception that crashed the whole app. This grid is never
                 meant to be edited directly (Edit opens its own dialog) -
                 set once, here, so every DataGrid in the app defaults to
                 this instead of each one needing to remember it. -->
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#F1F1F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <!-- No DataGridDetailsPresenter: this grid has no
                             RowDetailsTemplate, and including that
                             presenter anyway (copied from the stock
                             template without noticing) made WPF fall back
                             to its own default content rendering for the
                             selected row - which, for a plain object with
                             no ToString() override, is its full type name.
                             That is where "QemuManager.Models.VmListItem"
                             showing up under the selected row came from;
                             it was never adding, wiring, or forgetting a
                             real detail view, just unused boilerplate. -->
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorder}">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1C1F27"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1B2A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin, flat dark scrollbar everywhere (ScrollViewer's built-in
             one, every dialog's own, the DataGrid's) - previously
             completely unstyled, so it fell back to the OS's own light
             chrome, standing out sharply against every dark window/dialog
             around it (visible on VmEditWindow's own ScrollViewer in
             docs/screenshot.png). No arrow buttons at either end -
             deliberately a modern flat thumb-on-a-track look matching the
             rest of this app's own styling, not a reproduction of classic
             Win32 scrollbar chrome. -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource CardBorder}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeNS"/>
        </Style>

        <!-- A quiet keyboard-focus indicator - a thin accent-colored
             outline, rounded to match the row it sits on - instead of
             WPF's default dashed black/white rectangle (which, independent
             of IsSelected, stays on whichever item last had logical focus;
             a TreeView gives its first item that as soon as it loads, i.e.
             "Host", even though nothing selected it - that was the real
             cause of what first looked like "Host stuck with a darker
             background even when Virtual Machines is selected"). Disabling
             it outright (FocusVisualStyle="{x:Null}") fixed that same
             symptom but threw away real keyboard-navigation feedback along
             with it; this keeps the feedback, just restyled to fit. -->
        <Style x:Key="SubtleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1" StrokeThickness="1.3" Stroke="{StaticResource Accent}"
                                   RadiusX="5" RadiusY="5" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigator tree (Phase 1) - a plain TreeViewItem restyle, same
             "flat, hoverable row" look as SidebarButton rather than the
             default Windows tree chrome (indent guides, classic triangle
             glyphs on a light hover color that doesn't fit a dark app).
             Deliberately keyless (TargetType-matched, like the Button/
             TextBlock/TextBox styles above) so it applies equally to a
             TreeViewItem declared directly in XAML (the top-level Host/
             Virtual Machines/Storage/... nodes) and to one TreeView
             generates itself from an ItemsSource (the per-VM children under
             Virtual Machines) - an ItemContainerStyle reference would only
             ever reach the second kind. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#C7CBD4"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SubtleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Focusable="False" Width="14" Height="14"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Path x:Name="Arrow" Data="M0,0 L6,4 L0,8 Z" Fill="#8C93A3" Margin="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" CenterX="3" CenterY="4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1B2A3D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1C1F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
