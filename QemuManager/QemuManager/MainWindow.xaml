<Window x:Class="QemuManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QemuManager"
        Title="UHP Desktop" Height="700" Width="1200" MinHeight="480" MinWidth="860"
        Background="{StaticResource WindowBg}">
    <DockPanel>
        <!-- Top bar: product name, host name, search, settings. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="16,10"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Assets\uhp.svg, redrawn as XAML geometry (not the
                         bitmap) so it stays crisp at any DPI - same 4
                         rounded rectangles, same colors, just traced by
                         hand from the SVG's own coordinates/viewBox. -->
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Canvas Width="256" Height="256">
                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="52" RadiusY="52" Fill="#161A22"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="58" Width="48" Height="96" RadiusX="11" RadiusY="11" Fill="#3DA5F4"/>
                            <Rectangle Canvas.Left="104" Canvas.Top="58" Width="48" Height="96" RadiusX="11" RadiusY="11" Fill="#3DA5F4"/>
                            <Rectangle Canvas.Left="166" Canvas.Top="58" Width="48" Height="96" RadiusX="11" RadiusY="11" Fill="#2C7FC4"/>
                            <Rectangle Canvas.Left="34" Canvas.Top="170" Width="188" Height="28" RadiusX="11" RadiusY="11" Fill="#8C93A3"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="UHP Desktop" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HostNameText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" Margin="16,0,0,0"/>

                <!-- Right next to the host name, not off at the far side
                     of the bar next to Settings - sitting there made it
                     read as part of settings/configuration rather than as
                     a VM filter. -->
                <Grid Grid.Column="2" Margin="16,0,0,0">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="26,4,8,4"
                             TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search virtual machines"/>
                    <Canvas Width="12" Height="12" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Canvas.Left="0" Canvas.Top="0" Width="7" Height="7" Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                        <Line X1="6.3" Y1="6.3" X2="11" Y2="11" Stroke="{StaticResource TextDim}" StrokeThickness="1.5"/>
                    </Canvas>
                    <TextBlock Text="Search" Margin="26,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Far right, icon-only: a text "Settings" button sitting
                     right next to Search read as part of the search UI
                     rather than as a separate, unrelated action. Segoe
                     Fluent Icons' own gear glyph (E713, "Settings") - the
                     same glyph Windows' own Settings app uses - rather than
                     a hand-traced shape, so it stays pixel-correct at any
                     size and in any theme the way a font glyph always does. -->
                <Button x:Name="SettingsButton" Grid.Column="4" Click="SettingsButton_Click" Padding="8"
                        ToolTip="Settings" AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#F1F1F1"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body (navigator + content) on top, Recent tasks (collapsible,
             user-resizable via the GridSplitter) on the bottom. A Grid, not
             nested DockPanels, specifically so GridSplitter has rows it can
             resize. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="RecentTasksRow" Height="104"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="NavigatorTree" Background="Transparent" BorderThickness="0" Margin="4,12,4,0"
                              SelectedItemChanged="NavigatorTree_SelectedItemChanged" AutomationProperties.Name="Navigator">
                        <TreeViewItem x:Name="HostNode" Tag="Host">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14">
                                        <Rectangle Canvas.Left="1" Canvas.Top="2" Width="12" Height="8" RadiusX="1" RadiusY="1" Stroke="{StaticResource TextDim}" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="5.5" Canvas.Top="11" Width="3" Height="1.4" Fill="{StaticResource TextDim}"/>
                                    </Canvas>
                                    <TextBlock Text="Host" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem x:Name="VirtualMachinesNode" Tag="VirtualMachines" IsExpanded="True">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14">
                                        <Rectangle Canvas.Left="2" Canvas.Top="5" Width="10" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="5" Canvas.Top="2" Width="9" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" Fill="{StaticResource SidebarBg}"/>
                                    </Canvas>
                                    <TextBlock Text="Environments" Margin="8,0,0,0"/>
                                    <Border Background="{StaticResource CardBorder}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VmCountBadge" Text="0" FontSize="10" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeViewItem.ItemTemplate>
                            <!-- Without this, each generated TreeViewItem's
                                 own accessible name (what UI Automation and
                                 a screen reader actually read - the
                                 ItemTemplate above only sets what gets
                                 painted, not that) falls back to calling
                                 ToString() on the bound VmListItem, reading
                                 as "QemuManager.Models.VmListItem" instead
                                 of the VM's own name - found while verifying
                                 the VM detail page's own navigation via UI
                                 Automation, the same class of bug the
                                 DataGrid's stray DataGridDetailsPresenter
                                 caused visibly (see App.xaml's own history)
                                 but here only audible/inspectable, not seen
                                 on screen at all. -->
                            <!-- BasedOn the shared TreeViewItem style (App.xaml)
                                 is load-bearing, not cosmetic: without it, this
                                 ItemContainerStyle *replaces* that style for
                                 every VM row instead of adding to it, falling
                                 back to WPF's own stock TreeViewItem template -
                                 whose selected-row highlight uses
                                 SystemColors.InactiveSelectionHighlightBrush
                                 once the window itself loses focus, rendering
                                 as near-white text on a near-white row with
                                 the VM's name effectively invisible. Found via
                                 screenshot with the main window deliberately
                                 defocused (Notepad opened on top) - the shared
                                 style's own IsSelected-only trigger (not
                                 IsSelectionActive) is exactly what the other,
                                 statically-declared tree nodes already get for
                                 free, and VM rows must too. -->
                            <TreeViewItem.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                </Style>
                            </TreeViewItem.ItemContainerStyle>
                        </TreeViewItem>
                        <TreeViewItem x:Name="StorageNode" Tag="Storage">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14">
                                        <Rectangle Canvas.Left="2" Canvas.Top="3" Width="10" Height="8" RadiusX="1.5" RadiusY="1.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.2"/>
                                        <Line X1="2" Y1="6.5" X2="12" Y2="6.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.1"/>
                                        <Ellipse Canvas.Left="3.5" Canvas.Top="8.5" Width="1.8" Height="1.8" Fill="{StaticResource TextDim}"/>
                                    </Canvas>
                                    <TextBlock Text="Storage" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem x:Name="NetworkingNode" Tag="Networking">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14">
                                        <Line X1="7" Y1="3" X2="4" Y2="10.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.1"/>
                                        <Line X1="7" Y1="3" X2="10" Y2="10.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.1"/>
                                        <Ellipse Canvas.Left="5.2" Canvas.Top="0.5" Width="3.6" Height="3.6" Fill="{StaticResource TextDim}"/>
                                        <Ellipse Canvas.Left="1.5" Canvas.Top="9" Width="3.6" Height="3.6" Fill="{StaticResource TextDim}"/>
                                        <Ellipse Canvas.Left="8.9" Canvas.Top="9" Width="3.6" Height="3.6" Fill="{StaticResource TextDim}"/>
                                    </Canvas>
                                    <TextBlock Text="Networking" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem x:Name="EnginesNode" Tag="Engines">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14">
                                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="9" Height="9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2"/>
                                        <Ellipse Canvas.Left="5.7" Canvas.Top="5.7" Width="2.6" Height="2.6" Fill="{StaticResource TextDim}"/>
                                        <Line X1="7" Y1="0.3" X2="7" Y2="2" Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                        <Line X1="7" Y1="12" X2="7" Y2="13.7" Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                        <Line X1="0.3" Y1="7" X2="2" Y2="7" Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                        <Line X1="12" Y1="7" X2="13.7" Y2="7" Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                    </Canvas>
                                    <TextBlock Text="Engines" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeView>
                </Border>

                <!-- Content area: one page visible at a time, swapped by the
                     navigator selection. Host/Engines show real, currently-
                     available data; Storage/Networking are still a plainly-
                     labeled placeholder until Phase 6 builds them for real -
                     not a blank pane, not invented data. -->
                <Grid Grid.Column="1">
                    <DockPanel x:Name="VirtualMachinesPage" Visibility="Visible">
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="16,12"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="NewButton" Content="＋ New Environment" Click="NewButton_Click" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
                                <Button x:Name="StartButton" Content="▶  Power On" Click="StartButton_Click" Background="{StaticResource SuccessBg}"/>
                                <Button x:Name="StopButton" Content="Shut Down" Click="StopButton_Click"/>
                                <Button x:Name="ForceStopButton" Content="Force Stop" Click="ForceStopButton_Click" Background="{StaticResource DangerBg}"/>
                                <Button x:Name="ConsoleButton" Content="Console" Click="ConsoleButton_Click"/>
                                <Rectangle Width="1" Fill="{StaticResource CardBorder}" Margin="4,2,12,2"/>
                                <Button x:Name="EditButton" Content="Edit" Click="EditButton_Click"/>
                                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="VmList" Margin="0" SelectionChanged="VmList_SelectionChanged"
                                  MouseDoubleClick="VmList_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="VmList_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="VmList_ContextMenuOpening" AutomationProperties.Name="Environment list">
                            <DataGrid.ContextMenu>
                                <!-- Right-clicking a row selects it first (PreviewMouseRightButtonDown)
                                     and right-clicking empty space below the rows hides every item
                                     here except Create Environment (ContextMenuOpening) - see
                                     MainWindow.xaml.cs for both. -->
                                <ContextMenu>
                                    <MenuItem x:Name="CtxNewItem" Header="Create Environment" Click="NewButton_Click"/>
                                    <Separator x:Name="CtxSeparator1"/>
                                    <MenuItem x:Name="CtxStartItem" Header="Power On" Click="StartButton_Click"/>
                                    <MenuItem x:Name="CtxStopItem" Header="Shut Down" Click="StopButton_Click"/>
                                    <MenuItem x:Name="CtxForceStopItem" Header="Force Stop" Click="ForceStopButton_Click"/>
                                    <MenuItem x:Name="CtxConsoleItem" Header="Console" Click="ConsoleButton_Click"/>
                                    <Separator x:Name="CtxSeparator2"/>
                                    <MenuItem x:Name="CtxEditItem" Header="Edit" Click="EditButton_Click"/>
                                    <MenuItem x:Name="CtxDeleteItem" Header="Delete" Click="DeleteButton_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="24" CanUserResize="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                                <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="90"/>
                                <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="110"/>
                                <DataGridTextColumn Header="Host CPU" Binding="{Binding CpuPercentText}" Width="90"/>
                                <DataGridTextColumn Header="Host Memory" Binding="{Binding MemoryUsageText}" Width="100"/>
                                <DataGridTextColumn Header="Uptime" Binding="{Binding UptimeText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Phase 3: a specific VM's own detail page, shown
                         instead of VirtualMachinesPage when that VM's own
                         node under "Virtual Machines" is selected in the
                         navigator (not when "Virtual Machines" itself is -
                         see NavigatorTree_SelectedItemChanged). DataContext
                         is set to that VM's VmListItem in code, so every
                         binding below is live the same way the grid's own
                         columns already are - no separate refresh plumbing
                         needed, since VmListItem already raises
                         PropertyChanged for everything shown here. The
                         toolbar mirrors VirtualMachinesPage's own buttons
                         (same Click handlers, which already read from
                         SelectedItem rather than from sender - see
                         RefreshToolbarState for why these need their own
                         x:Name but no new code). -->
                    <DockPanel x:Name="VmDetailPage" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="16,12"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="&#x2190; Environments" Click="DetailBackButton_Click" Margin="0,0,16,0"/>
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DetailStartButton" Content="▶  Power On" Click="StartButton_Click" Background="{StaticResource SuccessBg}"/>
                                    <Button x:Name="DetailStopButton" Content="Shut Down" Click="StopButton_Click"/>
                                    <Button x:Name="DetailForceStopButton" Content="Force Stop" Click="ForceStopButton_Click" Background="{StaticResource DangerBg}"/>
                                    <Button x:Name="DetailConsoleButton" Content="Console" Click="ConsoleButton_Click"/>
                                    <Rectangle Width="1" Fill="{StaticResource CardBorder}" Margin="4,2,12,2"/>
                                    <Button x:Name="DetailEditButton" Content="Edit" Click="EditButton_Click"/>
                                    <Button x:Name="DetailDeleteButton" Content="Delete" Click="DeleteButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32">
                                <!-- Running: the same live numbers the grid's own columns show, just
                                     larger - plus Speed (MIPS, riscv-emu only) and Guest Detail
                                     (QMP, QEMU only), both gated on their own capability flag
                                     (Hardware.SupportsSpeedMetric/SupportsGuestDetail) rather than
                                     Kind, so a future third engine only has to set those flags
                                     correctly, not get found and fixed here too. Previously Speed
                                     just showed a bare "-" for every QEMU VM instead of being hidden. -->
                                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock Text="Host CPU" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding CpuPercentText}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock Text="Host Memory" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding MemoryUsageText}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock Text="Uptime" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding UptimeText}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110"
                                                Visibility="{Binding Hardware.SupportsSpeedMetric, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding MipsText}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" MinWidth="140"
                                                Visibility="{Binding Hardware.SupportsGuestDetail, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Guest Detail (QMP)" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding GuestDetail}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- GDB stub (roadmap item 3): shown only while running with
                                         Debug.GdbEnabled - the ready-made lldb command is what a
                                         person actually pastes into a terminal, not something to
                                         retype from the bare host:port. -->
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,0,20"
                                            Visibility="{Binding HasGdbEndpoint, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="GDB" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding GdbEndpoint, StringFormat='GDB: {0}'}" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding GdbAttachCommand}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Button x:Name="DetailGdbCopyButton" Content="Copy lldb command" Click="GdbCopyButton_Click" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Performance" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Host CPU, last hour" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                            <!-- Points set in code-behind (RedrawCpuHistory) from
                                                 IVmService.GetCpuHistory - a plain WPF app has no
                                                 charting control built in, and this is one line, not
                                                 worth a library dependency for. Fixed height; width
                                                 follows the card via Stretch, scaled to
                                                 CpuHistoryCanvas.ActualWidth at draw time.
                                                 Y-axis top is the actual max of the current sample
                                                 set, not a fixed 100% ceiling - a VM idling at 1-2%
                                                 CPU used to draw as a flat line hugging the bottom
                                                 with no visible scale at all. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock x:Name="CpuHistoryMaxLabel" Text="-" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="0%" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Canvas Grid.Column="1" x:Name="CpuHistoryCanvas" Height="100" ClipToBounds="True" SizeChanged="CpuHistoryCanvas_SizeChanged">
                                                    <Polyline x:Name="CpuHistoryLine" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                                </Canvas>
                                            </Grid>
                                            <Grid Margin="46,4,0,0">
                                                <TextBlock x:Name="CpuHistoryStartLabel" Text="" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="CpuHistoryEndLabel" Text="" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Stopped: no live stats exist, so show what IS still true (the
                                     VM's own configuration) instead of a wall of "-" tiles that used
                                     to be here, plus an explicit "no data" graph rather than an empty
                                     one that could be mistaken for "really was 0% the whole time". -->
                                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="This Environment is stopped - showing its configuration, not live stats." Foreground="{StaticResource TextDim}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding Hardware.CpuDescription}" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock Text="Memory" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding Hardware.MemoryDescription}" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="140">
                                            <StackPanel>
                                                <TextBlock Text="Disk" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding Hardware.DiskDescription}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" MinWidth="140">
                                            <StackPanel>
                                                <TextBlock Text="Network" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock Text="{Binding Hardware.NetworkDescription}" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Performance" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Height="100" Margin="0,0,0,20">
                                        <TextBlock Text="No data while stopped" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="General" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Engine" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.EngineDisplayName}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Created" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedText}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Config file" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfigFilePath}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Guest state (QMP)" Foreground="{StaticResource TextDim}"
                                                   Visibility="{Binding Hardware.SupportsGuestDetail, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GuestDetail}"
                                                   Visibility="{Binding Hardware.SupportsGuestDetail, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Hardware" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Engine" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.EngineDisplayName}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.Architecture}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.CpuDescription}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.MemoryDescription}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Disk" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.DiskDescription}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Network" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Hardware.NetworkDescription}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Console" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Hardware.ConsoleDescription}"/>
                                    </Grid>
                                </Border>

                                <!-- Phase 5: the same TerminalControl (xterm.js) ConsoleWindow
                                     uses, read-only here (see TerminalControl.ReadOnly) - a live
                                     stream still, continuously fed in Core regardless of whether a
                                     ConsoleWindow is also open (see IVmService.GetConsoleBuffer's
                                     own remarks), so a VM's boot log is still here to read even if
                                     nobody opened the console while it happened. Not clickable
                                     itself to open the full console any more - WebView2 is a real
                                     native child window (not a plain WPF visual), which always
                                     renders on top of and can intercept input ahead of any WPF
                                     sibling meant to catch a click "through" it; the text link below
                                     is a reliable, airspace-free way to do the same thing instead. -->
                                <TextBlock Text="Console" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Background="#0C0C0C" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Height="220">
                                    <local:TerminalControl x:Name="ConsolePreviewTerminal" ReadOnly="True"/>
                                </Border>
                                <TextBlock Text="Open the full console" Foreground="{StaticResource Accent}" Cursor="Hand"
                                           MouseLeftButtonUp="ConsolePreview_Click" Margin="0,6,0,0" FontSize="11.5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Phase 6: host machine facts, independent of any one
                         Environment - also where the running/total summary
                         that used to sit above the navigator tree now
                         lives (see MainWindow.xaml.cs's RefreshSummary). -->
                    <ScrollViewer x:Name="HostPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32">
                            <TextBlock Text="Host" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="HostSummaryText" Foreground="{StaticResource TextDim}" Margin="0,0,0,16"/>

                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating system" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HostOsText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HostCpuText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HostMemoryText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Free disk space" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HostFreeDiskText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="WHPX" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="HostWhpxText" Grid.Row="4" Grid.Column="1"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Running Environments" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="Running / Total" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HostRunningCountText" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,10,0" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="Total Host CPU" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HostTotalCpuText" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="Total Host Memory" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HostTotalMemoryText" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Phase 6: both engines' own install status, with
                         path-editing moved here from the old Settings
                         dialog (see SettingsWindow.xaml's own remarks) -
                         Browse (or typing + leaving the box) re-validates
                         and re-saves immediately, rather than waiting for
                         an OK button that no longer exists on this page. -->
                    <ScrollViewer x:Name="EnginesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32">
                            <TextBlock Text="Engines" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse x:Name="QemuStatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="QEMU" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="QemuStatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QemuDirBox" Grid.Column="0" LostFocus="QemuDirBox_LostFocus" AutomationProperties.Name="QEMU directory"/>
                                        <Button x:Name="QemuBrowseButton" Grid.Column="1" Content="Browse..." Click="QemuBrowseButton_Click" AutomationProperties.Name="Browse QEMU directory"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="QemuVersionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Architectures" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="QemuArchitecturesText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Environments" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="QemuEnvironmentCountText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="WHPX" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock x:Name="QemuWhpxText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse x:Name="RiscvEmuStatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="riscv-emu" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RiscvEmuStatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RiscvEmuDirBox" Grid.Column="0" LostFocus="RiscvEmuDirBox_LostFocus" AutomationProperties.Name="riscv-emu directory"/>
                                        <Button x:Name="RiscvEmuBrowseButton" Grid.Column="1" Content="Browse..." Click="RiscvEmuBrowseButton_Click" AutomationProperties.Name="Browse riscv-emu directory"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="RiscvEmuVersionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Architectures" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="RiscvEmuArchitecturesText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Environments" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock x:Name="RiscvEmuEnvironmentCountText" Grid.Row="2" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Phase 6: every disk image this app knows about -
                         gathered from every Environment's own
                         Workload.DiskPath plus AppPaths.DisksDir (see
                         IVmService.GetDiskInventoryAsync). "Create disk"
                         moved here from the editor (see
                         EnvironmentEditWindow.xaml.cs's own remarks on its
                         disk field) - the editor only points to this page
                         now, it does not open its own copy of this dialog. -->
                    <DockPanel x:Name="StorageDiskPage" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="16,12"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Storage" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CreateDiskButton" Content="＋ Create disk..." Click="CreateDiskButton_Click" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
                                    <Button x:Name="OpenDiskFolderButton" Content="Open folder" Click="OpenDiskFolderButton_Click"/>
                                    <Button x:Name="RemoveDiskButton" Content="Remove from list" Click="RemoveDiskButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="DiskList" Margin="0" SelectionChanged="DiskList_SelectionChanged" AutomationProperties.Name="Disk list">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                                <DataGridTextColumn Header="Virtual size" Binding="{Binding VirtualSizeText}" Width="100"/>
                                <DataGridTextColumn Header="Size on disk" Binding="{Binding ActualSizeText}" Width="100"/>
                                <DataGridTextColumn Header="Used by" Binding="{Binding UsedByText}" Width="2*"/>
                                <DataGridTextColumn Header="Exists" Binding="{Binding ExistsText}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Phase 6: per-Environment network configuration,
                         read-only - no port forwarding yet (see
                         vision/NEXT.md). -->
                    <DockPanel x:Name="NetworkingPage" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="16,12"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Networking" FontSize="18" FontWeight="Bold"/>
                        </Border>
                        <DataGrid x:Name="NetworkList" Margin="0" IsReadOnly="True" AutomationProperties.Name="Network list">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Environment" Binding="{Binding EnvironmentName}" Width="2*"/>
                                <DataGridTextColumn Header="Engine" Binding="{Binding EngineDisplayName}" Width="100"/>
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                                <DataGridTextColumn Header="Guest address" Binding="{Binding GuestAddressText}" Width="120"/>
                                <DataGridTextColumn Header="Gateway" Binding="{Binding GatewayAddressText}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Grid>

            <GridSplitter x:Name="RecentTasksSplitter" Grid.Row="1"/>

            <!-- Recent tasks: collapsible, replaces the old single-line
                 status bar. Column header row is already Task/Target/
                 Started/Result - the list below is still one combined line
                 per entry until Phase 4 restructures it into real rows. -->
            <Border x:Name="RecentTasksPanel" Grid.Row="2" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Tasks" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            <Button x:Name="RecentTasksToggleButton" Grid.Column="1" Content="Hide" Click="RecentTasksToggleButton_Click"
                                    Padding="8,3" Margin="0" FontSize="11"/>
                        </Grid>
                    </Border>
                    <Grid x:Name="RecentTasksColumnHeader" DockPanel.Dock="Top" Background="{StaticResource CardBg}" Margin="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Task" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="14,4"/>
                        <TextBlock Grid.Column="1" Text="Target" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="0,4"/>
                        <TextBlock Grid.Column="2" Text="Started" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="0,4"/>
                        <TextBlock Grid.Column="3" Text="Completed" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="0,4"/>
                        <TextBlock Grid.Column="4" Text="Result" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="0,4"/>
                    </Grid>
                    <!-- Phase 4: a real Task/Target/Started/Completed/Result
                         row per item (MainWindow.xaml.cs's RefreshRecentTasks
                         binds this straight to VmService.GetRecentTasks, a
                         plain List<TaskRecord>) - not the single combined
                         line this used to be. Result's own color flags
                         Running (still in progress - Accent, matching the
                         same brush the rest of the app uses for "this is
                         live/in-flight") and Failed (ErrorText, same brush
                         Settings/VmEditWindow's own validation text already
                         uses for an error) - Succeeded is just the default
                         foreground, nothing needs to draw attention to it. -->
                    <ListBox x:Name="RecentTasksList" Background="Transparent" BorderThickness="0"
                             Foreground="#F1F1F1" FontSize="11.5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Recent tasks">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Padding="14,3" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Target}" Padding="0,3" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Started, StringFormat='HH:mm:ss'}" Padding="0,3"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Completed, StringFormat='HH:mm:ss'}" Padding="0,3"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Result}" Padding="0,3" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
