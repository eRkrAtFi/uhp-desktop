<Window x:Class="QemuManager.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QemuManager"
        Title="riscv-emu console" Height="520" Width="800" MinHeight="300" MinWidth="500"
        Background="{StaticResource WindowBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" Padding="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Text="riscv-emu" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
                <Button x:Name="ForceStopButton" Content="Force Stop" Click="ForceStopButton_Click" Background="{StaticResource DangerBg}"/>
                <!-- Phase 5: the terminal itself (TerminalControl, below)
                     already sends Ctrl+C straight to the guest with no
                     Enter needed - this button is a convenience for a
                     touch/mouse-only user, or one who does not know the
                     shortcut, not a stand-in for real input handling any
                     more. -->
                <Button x:Name="SendCtrlCButton" Content="Send Ctrl+C" Click="SendCtrlCButton_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
            </StackPanel>
        </Border>

        <local:TerminalControl x:Name="Terminal"/>
    </DockPanel>
</Window>
