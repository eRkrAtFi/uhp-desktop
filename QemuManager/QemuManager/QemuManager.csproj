<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.FolderBrowserDialog; the UI itself stays WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- AssemblyName/RootNamespace deliberately left as QemuManager for now -
         this is the cosmetic/UI-facing layer of the rebranding brainstorm
         (see README.md), not the full technical rename across namespaces,
         project/folder names and docs. -->
    <AssemblyName>QemuManager</AssemblyName>
    <RootNamespace>QemuManager</RootNamespace>
    <Product>Universal Hypervisor Platform (UHP)</Product>
    <AssemblyTitle>UHP Desktop</AssemblyTitle>
    <ApplicationIcon>Assets\uhp.ico</ApplicationIcon>
    <!-- Set below (SetSourceRevisionId target), from the latest "v*"
         git tag (via "git describe"), NOT a value bumped by hand here,
         which drifted from the actual release tag at least once (this
         file said 0.1.0 while the real release was already v0.2.0).
         SourceRevisionId (short commit hash, -dirty if the working tree
         has uncommitted changes, build timestamp) is what makes two
         builds between releases distinguishable; Version itself is what
         makes a build actually say which release it is. Read at runtime
         as
         Assembly.GetEntryAssembly().GetCustomAttribute&lt;AssemblyInformationalVersionAttribute&gt;()
         (SettingsWindow, CrashLogger) and externally, with no need to
         run the app at all, via (Get-Item QemuManager.exe).VersionInfo.ProductVersion
         (finish.ps1's own last line) - both read the exact same string,
         the SDK's own standard mechanism for this, not a custom one. -->
    <Version>0.0.0</Version>
    <!-- Self-contained single-file publish: the point is a standalone .exe
         that needs no separately-installed .NET runtime on the target
         machine. QEMU itself remains an external dependency, located at
         run time rather than bundled. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF's own binding/culture plumbing needs real ICU data; invariant
         globalization breaks XmlLanguage lookups used by every binding. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UHP.Core\UHP.Core.csproj" />
  </ItemGroup>

  <!-- Computes SourceRevisionId (short commit hash, -dirty if the
       working tree has uncommitted changes, UTC build timestamp) before
       the SDK's own GenerateAssemblyInfo step consumes it - the SDK
       appends "+$(SourceRevisionId)" to AssemblyInformationalVersion
       automatically once this is set, which is also what ends up in the
       built .exe's own "Product Version" PE resource field, so no
       separate generated-source-file plumbing is needed for either the
       in-app (SettingsWindow/CrashLogger) or external (finish.ps1) read
       of it. git must be on PATH; if it is not (or this somehow is not
       a git checkout), GitHash falls back to "unknown" rather than
       failing the build over a version string. -->
  <!-- Separate from SetSourceRevisionId below, and deliberately anchored
       much earlier (BeforeTargets="BeforeBuild", not tied to
       InitializeSourceControlInformation at all - git describe needs
       nothing from the SDK's own source-control integration): Version
       feeds into AssemblyInformationalVersion's own BASE value, which the
       SDK computes well before InitializeSourceControlInformation runs -
       confirmed directly (setting Version from the AfterTargets=
       InitializeSourceControlInformation target below, same as
       SourceRevisionId, left ProductVersion at the static fallback
       "0.0.0" even though SourceRevisionId's own override from that same
       target DID take effect - the two are not combined at the same
       point in the build). -->
  <Target Name="SetVersionFromGitTag" BeforeTargets="BeforeBuild">
    <!-- The "tags" flag: a lightweight tag counts too, not just
         annotated (this project's own release tags are annotated, but
         no reason to depend on that). The "match" flag, "v*": guest-
         images-v* tags exist in this same repo and must never be picked
         up here. The "abbrev" flag at 0: just the tag name itself, no
         distance-from-HEAD suffix - this build's own exact commit
         distance/dirty state is already SourceRevisionId's own job, not
         Version's. ContinueOnError, with a fallback (the static "0.0.0"
         above), same reasoning as GitHash below: a missing git, a
         shallow clone with no tags fetched, or a checkout with no v* tag
         yet at all must not fail the build over a version string. -->
    <Exec Command="git describe --tags --match &quot;v*&quot; --abbrev=0" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitVersionTagOutput" />
      <Output TaskParameter="ExitCode" PropertyName="GitVersionTagExitCode" />
    </Exec>
    <PropertyGroup>
      <!-- Strips the leading "v" ("v0.2.0" -> "0.2.0") - Version is a
           plain dotted number, the SDK itself would reject a "v" prefix
           when computing AssemblyVersion from it. -->
      <GitVersionTag Condition="'$(GitVersionTagExitCode)' == '0' AND '$(GitVersionTagOutput)' != ''">$(GitVersionTagOutput)</GitVersionTag>
      <Version Condition="'$(GitVersionTag)' != ''">$(GitVersionTag.TrimStart('v'))</Version>
    </PropertyGroup>
  </Target>

  <!-- AfterTargets="InitializeSourceControlInformation": the SDK's own
       git integration (active automatically once it detects this is a
       git checkout) sets SourceRevisionId itself, to the *full* 40-char
       commit hash with no dirty/timestamp info - confirmed directly
       (ProductVersion came out as "0.1.0+b99ac1d27dcbe9d..." before this
       was added). Running after that target, not merely before
       CoreCompile, is what actually lets this override it rather than
       silently losing to it. -->
  <Target Name="SetSourceRevisionId" AfterTargets="InitializeSourceControlInformation" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHashOutput" />
      <Output TaskParameter="ExitCode" PropertyName="GitHashExitCode" />
    </Exec>
    <!-- The untracked_files=no flag below matches git describe's own
         "dirty" convention: an untracked file (e.g. a pending-approval
         riscv-emu/buildroot/ directory deliberately kept out of git
         until reviewed) says nothing about whether the SOURCE this
         build actually compiled matches HEAD, which is the only thing
         the dirty suffix is meant to warn about. Confirmed this was
         the actual cause of an otherwise-clean HEAD still publishing
         with that suffix. -->
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatusOutput" />
    </Exec>
    <PropertyGroup>
      <GitHash Condition="'$(GitHashExitCode)' == '0' AND '$(GitHashOutput)' != ''">$(GitHashOutput)</GitHash>
      <GitHash Condition="'$(GitHash)' == ''">unknown</GitHash>
      <DirtySuffix Condition="'$(GitStatusOutput)' != ''">-dirty</DirtySuffix>
      <BuildTimeStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))Z</BuildTimeStamp>
      <SourceRevisionId>$(GitHash)$(DirtySuffix).built-$(BuildTimeStamp)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- ApplicationIcon above only embeds this into the .exe's own Win32
         resources (Explorer/taskbar/Alt+Tab icon) - it is a separate asset
         from the app's own runtime resources, so a WPF window binding its
         own Icon property to "pack://application:,,,/Assets/uhp.ico"
         (see App.xaml's shared Window style) needs it included here too. -->
    <Resource Include="Assets\uhp.ico" />
  </ItemGroup>

</Project>
