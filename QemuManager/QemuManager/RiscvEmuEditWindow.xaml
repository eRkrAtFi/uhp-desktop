<Window x:Class="QemuManager.RiscvEmuEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="riscv-emu VM Configuration" Height="500" Width="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Save" Click="OkButton_Click" Background="{StaticResource SuccessBg}"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/> <RowDefinition/> <RowDefinition/>
                <RowDefinition/> <RowDefinition/> <RowDefinition/>
                <RowDefinition/> <RowDefinition/> <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="VM name"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kernel Image"/>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KernelBox" Grid.Column="0" AutomationProperties.Name="Kernel Image path"/>
                <Button x:Name="KernelBrowseButton" Grid.Column="1" Content="Browse..." Click="KernelBrowseButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Initramfs"/>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InitrdBox" Grid.Column="0" AutomationProperties.Name="Initramfs path"/>
                <Button x:Name="InitrdBrowseButton" Grid.Column="1" Content="Browse..." Click="InitrdBrowseButton_Click"/>
                <Button x:Name="InitrdClearButton" Grid.Column="2" Content="Clear" Click="InitrdClearButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Disk image"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DiskBox" Grid.Column="0" AutomationProperties.Name="Disk image path"/>
                <Button x:Name="DiskBrowseButton" Grid.Column="1" Content="Browse..." Click="DiskBrowseButton_Click"/>
                <Button x:Name="DiskClearButton" Grid.Column="2" Content="Clear" Click="DiskClearButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Memory"/>
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MemoryBox" Grid.Column="0" AutomationProperties.Name="Memory in MB"/>
                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,10"/>
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Network"/>
            <CheckBox x:Name="NetworkCheckBox" Grid.Row="5" Grid.Column="1" Content="Attach virtio-net (NATed through this host)"
                      Foreground="#F1F1F1" VerticalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Extra boot args" VerticalAlignment="Top" Margin="0,4,10,0"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical">
                <TextBox x:Name="ExtraArgsBox" AutomationProperties.Name="Extra kernel boot arguments"/>
                <TextBlock Text="Appended to the kernel command line (console=ttyS0 earlycon=sbi is always set)."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,-6,0,10"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Shutdown command" VerticalAlignment="Top" Margin="0,4,10,0"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Vertical">
                <TextBox x:Name="ShutdownCommandBox" AutomationProperties.Name="Shutdown command"/>
                <TextBlock Text="Typed into the guest console when Shutdown is requested. Default works for this app's bundled busybox image; a guest with a real init system (e.g. Alpine on disk) should use plain &quot;poweroff&quot; instead."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,-6,0,10"/>
            </StackPanel>

            <TextBlock x:Name="ValidationText" Grid.Row="8" Grid.Column="1" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap"/>
        </Grid>
    </DockPanel>
</Window>
